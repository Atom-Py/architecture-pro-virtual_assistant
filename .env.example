# OpenAI-совместимый API (OpenAI, vLLM, LiteLLM), адрес оканчивается на /v1
LLM_BASE_URL=https://llm.example.com/v1
LLM_API_KEY=
LLM_MODEL=

# слои защиты от промпт-инъекций: prompt, filter, sanitize (пусто - без защиты)
RAG_GUARDS=prompt,filter,sanitize

# токен от @BotFather и Telegram ID пользователей через запятую
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
